# Копирай на .env и смени стойностите преди `./deploy.sh`
# ВАЖНО: .env не се качва в git.

# Порт на приложението в контейнера (домейнът 80/443 се пренасочва към него)
PORT=48081

# Часова зона (важна за търговските сесии)
TZ=Europe/Sofia

# GitHub източник (за build и за авто-обновяване при рестарт)
GIT_REPO=https://github.com/niangoto/Helious.git
GIT_REF=main
# 1 = при всяко стартиране на контейнера да тегли последното от GitHub
AUTO_UPDATE=1

# PostgreSQL
POSTGRES_USER=helious
POSTGRES_PASSWORD=change_me_silna_parola
POSTGRES_DB=helious

# 32-байтов ключ (hex) за криптиране на MT5 паролите.
# Генерирай с: openssl rand -hex 32
ENCRYPTION_KEY=replace_with_openssl_rand_hex_32
